# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; .env.example is tracked.

# --- Restaurant Service database ---
RESTAURANT_DB_NAME=restaurant_db
RESTAURANT_DB_USER=restaurant_user
RESTAURANT_DB_PASSWORD=restaurant_pw

# --- Menu Service database ---
MENU_DB_NAME=menu_db
MENU_DB_USER=menu_user
MENU_DB_PASSWORD=menu_pw

# --- Host port overrides ---
# Defaults match the master plan port matrix (5432 / 5433). If your
# machine already runs another PostgreSQL on one of these ports (e.g.
# a Windows "postgresql-x64-*" service), override here -- typical
# collision-free choice is 5442 / 5443. After overriding, also set
# DB_URL in each service's IntelliJ Run Configuration, e.g.
#   DB_URL=jdbc:postgresql://localhost:5442/restaurant_db
RESTAURANT_DB_HOST_PORT=5432
MENU_DB_HOST_PORT=5433

# --- JWT (HS256 shared secret for dev tokens) ---
# Base64-encoded 256-bit key. Regenerate with:
#   openssl rand -base64 32
# Do NOT reuse the placeholder in any shared/team/production environment.
JWT_SECRET=dGVzdC1zZWNyZXQtZm9yLWRldi1vbmx5LWRvLW5vdC11c2UtaW4tcHJvZC0xMjM0NTY=
JWT_ISSUER=quickbite-user-service

# --- Downstream service URLs ---
# Sten's services do not call each other, but the env-var names
# are fixed so future phases only need to flip values.
RESTAURANT_SERVICE_URL=http://localhost:8081
MENU_SERVICE_URL=http://localhost:8082

# --- Frontend (Phase 14) ---
# The Vue build is served by nginx inside the `frontend` service.
# FRONTEND_HOST_PORT picks the host port that maps to container :80.
# GATEWAY_UPSTREAM tells nginx where to proxy /api/**. Default is the
# `dev-gateway` stub (Phase 14) because this personal repo always runs
# with `--profile dev-gateway`. When the team's combined compose is in
# use (Alfa-Kilo's gateway on the same network), flip this to
# `http://api-gateway:8080`. Use `http://host.docker.internal:8080` to
# hit a gateway running on the host instead.
FRONTEND_HOST_PORT=8090
GATEWAY_UPSTREAM=http://dev-gateway:80

# --- Dev-gateway stub (Phase 14, optional) ---
# Opt-in via the `dev-gateway` compose profile. Stands in for the
# real gateway when Alfa-Kilo hasn't committed theirs yet. Does NOT
# handle /api/auth/login -- use JwtDevMint.java or paste a token.
#     docker compose --profile dev-gateway --env-file .env.local up -d
# The default GATEWAY_UPSTREAM above already points at this stub.
DEV_GATEWAY_HOST_PORT=8080
# COMPOSE_PROFILES=dev-gateway
