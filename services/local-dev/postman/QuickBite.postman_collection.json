          "name": "[200 all valid] POST /menu-items/validate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('allValid is true', () => pm.expect(body.allValid).to.eql(true));",
                  "pm.test('items length matches request', () => pm.expect(body.items).to.have.lengthOf(2));",
                  "pm.test('every line exists + isAvailable', () => {",
                  "    body.items.forEach(line => {",
                  "        pm.expect(line.exists).to.eql(true);",
                  "        pm.expect(line.isAvailable).to.eql(true);",
                  "        pm.expect(Number(line.lineTotal)).to.be.a('number');",
                  "    });",
                  "});",
                  "pm.test('totalAmount matches 2x10.50 + 1x5.00 = 26.00', () => pm.expect(Number(body.totalAmount)).to.eql(26));",
                  "pm.test('currency defaults to EUR', () => pm.expect(body.currency).to.eql('EUR'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
