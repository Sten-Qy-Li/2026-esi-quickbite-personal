{
  "info": {
    "name": "QuickBite",
    "description": "Sierra-Lima's Restaurant + Menu services. Phase 7 hardening: tokens auto-minted for each of the 3 roles via a collection-level pre-request script (CryptoJS HS256), so every request has a fresh customerToken / ownerToken / adminToken in scope. Negative Auth folder covers the 401 / 403 / 400 / 404 / 422 edges.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Dev-only JWT minter. Signs with the same HS256 secret baked into",
          "// restaurant-service and menu-service application.properties",
          "// (JWT_SECRET env var overrides). Keep in sync with JwtDevMint.java.",
          "",
          "const base64Secret = pm.environment.get('jwtSecret')",
          "    || 'dGVzdC1zZWNyZXQtZm9yLWRldi1vbmx5LWRvLW5vdC11c2UtaW4tcHJvZC0xMjM0NTY=';",
          "const issuer = pm.environment.get('jwtIssuer') || 'quickbite-user-service';",
          "",
          "const b64url = (b64) => b64.replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "const encode = (obj) => b64url(CryptoJS.enc.Base64.stringify(",
          "    CryptoJS.enc.Utf8.parse(JSON.stringify(obj))));",
          "",
          "const mint = (userId, subject, role) => {",
          "    const now = Math.floor(Date.now() / 1000);",
          "    const header = { alg: 'HS256', typ: 'JWT' };",
          "    const payload = {",
          "        iss: issuer,",
          "        sub: subject,",
          "        userId: userId,",
          "        role: role,",
          "        tokenType: 'USER',",
          "        iat: now,",
          "        exp: now + 3600",
          "    };",
          "    const signingInput = encode(header) + '.' + encode(payload);",
          "    const key = CryptoJS.enc.Base64.parse(base64Secret);",
          "    const sig = b64url(CryptoJS.enc.Base64.stringify(",
          "        CryptoJS.HmacSHA256(signingInput, key)));",
          "    return signingInput + '.' + sig;",
          "};",
          "",
          "const customerToken   = mint('00000000-0000-0000-0000-0000000000c1', 'dev-customer',    'Customer');",
          "const ownerToken      = mint('00000000-0000-0000-0000-000000000001', 'dev-owner',       'RestaurantOwner');",
          "// Owner 002 seeds Cafe Nero/Burger Bros -- used by Negative Auth tests",
          "// to prove 'Owner A on restaurant B' returns 403 on d0000001 (owned by 001).",
          "const otherOwnerToken = mint('00000000-0000-0000-0000-000000000002', 'dev-owner-other', 'RestaurantOwner');",
          "const adminToken      = mint('00000000-0000-0000-0000-0000000000a1', 'dev-admin',       'Admin');",
          "",
          "pm.environment.set('customerToken',   customerToken);",
          "pm.environment.set('ownerToken',      ownerToken);",
          "pm.environment.set('otherOwnerToken', otherOwnerToken);",
          "pm.environment.set('adminToken',      adminToken);",
          "// Back-compat alias for pre-Phase-7 requests.",
          "pm.environment.set('jwtToken', ownerToken);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth (Tokens)",
      "description": "Tokens are minted client-side by the collection-level pre-request script. These stub requests exist so you can run them to confirm the target service is reachable and print the minted token in the console. Once Alfa-Kilo's User Service ships, replace with a real `POST /api/auth/login`.",
      "item": [
        {
          "name": "Mint Customer Token (prints to console)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('customerToken =', pm.environment.get('customerToken'));",
                  "pm.test('customer token minted', () => {",
                  "    pm.expect(pm.environment.get('customerToken')).to.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{restaurantBaseUrl}}/actuator/health",
              "host": ["{{restaurantBaseUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        },
