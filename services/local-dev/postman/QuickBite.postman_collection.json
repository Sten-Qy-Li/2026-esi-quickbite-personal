            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{restaurantBaseUrl}}/restaurants/ffffffff-ffff-ffff-ffff-ffffffffffff",
              "host": ["{{restaurantBaseUrl}}"],
