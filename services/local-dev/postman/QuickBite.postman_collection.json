                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('isOpen is false for Cafe Nero seed', () => pm.expect(body.isOpen).to.eql(false));",
                  "pm.test('acceptsOrders is false when isOpen is false', () => pm.expect(body.acceptsOrders).to.eql(false));",
                  "pm.test('operatingHours still reported', () => pm.expect(body.operatingHours).to.match(/^\\d{2}:\\d{2}-\\d{2}:\\d{2}$/));",
                  "pm.test('checkedAt present', () => pm.expect(body.checkedAt).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{restaurantBaseUrl}}/restaurants/{{restaurantClosedId}}/availability",
