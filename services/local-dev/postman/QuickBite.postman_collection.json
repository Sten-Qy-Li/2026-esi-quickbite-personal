    {
      "name": "Negative Auth",
      "description": "Route-protection matrix evidence. Each request has a test assertion that pins the expected status.",
      "item": [
        {
          "name": "[401] GET /restaurants/{id}/availability  no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('envelope has status field', () => {",
                  "    pm.expect(pm.response.json()).to.have.property('status', 401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{restaurantBaseUrl}}/restaurants/{{restaurantId}}/availability",
              "host": ["{{restaurantBaseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}", "availability"]
            }
          }
        },
        {
          "name": "[401] GET /availability  garbage Bearer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer this.is.not-a-valid-token" }],
            "url": {
              "raw": "{{restaurantBaseUrl}}/restaurants/{{restaurantId}}/availability",
              "host": ["{{restaurantBaseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}", "availability"]
            }
          }
        },
