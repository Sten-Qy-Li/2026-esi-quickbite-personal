    {
      "name": "W1 Integration",
      "description": "Phase 10 integration evidence. The two hops Order Service makes into Sierra-Lima (availability + batch validate) are exercised end-to-end against the locked contracts in 0030 and the status-code table in 0031. Each request has a test block pinning the expected status and body shape -- run the folder with Newman to produce failure-path evidence for CP#1.",
      "item": [
        {
          "name": "[200 open] GET /restaurants/{open}/availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('restaurantId echoes path', () => pm.expect(body.restaurantId).to.eql(pm.environment.get('restaurantId')));",
                  "pm.test('isOpen is true for Pizza Antonio seed', () => pm.expect(body.isOpen).to.eql(true));",
                  "pm.test('acceptsOrders is boolean', () => pm.expect(body.acceptsOrders).to.be.a('boolean'));",
                  "pm.test('operatingHours present', () => pm.expect(body.operatingHours).to.match(/^\\d{2}:\\d{2}-\\d{2}:\\d{2}$/));",
                  "pm.test('checkedAt is ISO-8601', () => pm.expect(new Date(body.checkedAt).toString()).to.not.eql('Invalid Date'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{restaurantBaseUrl}}/restaurants/{{restaurantId}}/availability",
              "host": ["{{restaurantBaseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}", "availability"]
            }
          }
        },
        {
          "name": "[200 closed] GET /restaurants/{closed}/availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
