              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('validationErrors present', () => {",
                  "    pm.expect(pm.response.json().validationErrors).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"items\": [] }"
            },
            "url": {
              "raw": "{{menuBaseUrl}}/menu-items/validate",
              "host": ["{{menuBaseUrl}}"],
              "path": ["menu-items", "validate"]
            }
          }
        },
